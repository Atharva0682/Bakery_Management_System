# ==============================================================================
# CRUMB & CO. BAKERY MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secure-crumb-and-co-jwt-token-secret-key-2026

# PostgreSQL Database Configuration
# If PostgreSQL is running locally, the system connects directly.
# If PostgreSQL is offline/unreachable, resilient in-memory mode activates automatically with zero latency.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bakery_db
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_DEFAULT_BUSINESS_SLUG=crumbandco
